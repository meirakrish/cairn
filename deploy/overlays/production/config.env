NODE_ENV=production
API_PORT=3000
# The public https origin: OAuth redirect and the Origin check. Redirect URI: <origin>/api/auth/google/callback
APP_ORIGIN=https://cairn.example.com

# LLM is an external service. A present API key picks its provider (LLM_PROVIDER overrides).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# Anthropic has no embeddings API, so embeddings come from an Ollama you run (pull qwen3-embedding:0.6b there).
EMBED_PROVIDER=ollama
EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_HOST=http://ollama.example.com:11434
# Fixed by chunks.embedding vector(1024).
EMBED_DIMENSIONS=1024
WORKER_CONCURRENCY=2

QUERY_RATE_LIMIT=20
SHARE_QUERY_RATE_LIMIT=60
SSE_MAX_STREAMS_PER_USER=3
QUIZ_PREFETCH=2
MODERATION_ENABLED=true
UPLOAD_MAX_MEGA_BYTES=25

S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=cairn
