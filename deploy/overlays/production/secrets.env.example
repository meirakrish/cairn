# Copy to secrets.env (gitignored). Passwords must agree across lines; generate your own.
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
REDIS_PASSWORD=change-me-three
# 32 bytes hex: openssl rand -hex 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# Garage key format: GK + 24 hex chars; secret is 64 hex chars.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Built from the passwords above (in-cluster service names).
DATABASE_URL=postgres://cairn_app:change-me-too@postgres:5432/cairn
DATABASE_ADMIN_URL=postgres://postgres:change-me@postgres:5432/cairn
REDIS_URL=redis://:change-me-three@redis:6379

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
