{
  "name": "cairn",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @cairn/api --filter @cairn/web --filter @cairn/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "eval": "pnpm --filter @cairn/eval eval",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @cairn/core db:generate",
    "db:migrate": "pnpm --filter @cairn/core db:migrate",
    "infra:up": "kubectl --context ${KUBE_CONTEXT:-cairn} apply -k deploy/overlays/minikube",
    "infra:status": "kubectl --context ${KUBE_CONTEXT:-cairn} -n cairn get pods,pvc,jobs",
    "infra:forward": "scripts/infra-forward.sh",
    "infra:reset": "kubectl --context ${KUBE_CONTEXT:-cairn} delete -k deploy/overlays/minikube"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
